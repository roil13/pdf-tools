{
  "name": "pdf-tools",
  "version": "0.1.0",
  "description": "Offline PDF toolkit for Windows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roil13/pdf-tools.git"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && node scripts/dev.mjs",
    "build": "node scripts/copy-assets.mjs && node scripts/build-electron.mjs && vite build",
    "package": "npm run build && electron-builder && node scripts/verify-package.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/make-fixtures.mjs",
    "assets": "node scripts/copy-assets.mjs",
    "e2e": "node scripts/e2e-ocr.mjs",
    "probe:assets": "node scripts/probe-assets.mjs",
    "probe:packaged": "node scripts/probe-packaged.mjs",
    "verify": "npm run audit && npm run typecheck && npm test && npm run e2e && npm run e2e:ui && npm run e2e:reader && npm run e2e:crop",
    "e2e:ui": "node scripts/e2e-ui.mjs",
    "shoot": "node scripts/shoot.mjs",
    "audit": "node scripts/audit.mjs",
    "e2e:reader": "node scripts/e2e-reader.mjs",
    "android": "node scripts/build-android.mjs",
    "android:run": "node scripts/build-android.mjs --run",
    "probe:android": "node scripts/probe-android.mjs",
    "e2e:crop": "node scripts/e2e-crop.mjs",
    "android:apk": "node scripts/build-android.mjs --apk",
    "android:apk:release": "node scripts/build-android.mjs --apk-release"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@capgo/capacitor-document-scanner": "^8.4.5",
    "@capgo/capacitor-file-sharer": "^8.1.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "libheif-js": "^1.19.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "author": "Lior Yosub"
}
